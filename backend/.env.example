NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://saas:saas@localhost:5433/saas_subscriptions?schema=public
JWT_SECRET=change-me-in-production
# Access token lifetime in seconds (28800 = 8h)
JWT_EXPIRES_IN_SECONDS=28800
# Percentage of the contracted API call limit at which usage alerts trigger
USAGE_ALERT_THRESHOLD=0.8
# Percentage of the contracted license limit at which license alerts trigger
LICENSE_ALERT_THRESHOLD=0.8
# How often (ms) the AlertsScheduler sweeps all companies for threshold crossings
ALERT_CHECK_INTERVAL_MS=15000
# SMTP used to email company ADMINs when usage/licenses cross their alert threshold.
# Points at the Mailhog container from docker-compose by default (localhost:8025 to view sent mail).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=alerts@saas-subscriptions.test
# Optional: set these in your own local .env (never commit real credentials) to
# deliver to a real inbox instead of Mailhog, e.g. Gmail SMTP with an App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
